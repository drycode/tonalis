{
  "name": "tonalis",
  "version": "0.1.0",
  "description": "Tonalis — a generic, format-agnostic music-harmony DSL (parse/lint/AST/JSON/text). Depends only on the pure, zero-dependency music_dsl theory library; browser + Node safe.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/drycode/tonalis.git", "directory": "leadsheet/ts" },
  "homepage": "https://github.com/drycode/tonalis#readme",
  "private": false,
  "dependencies": {
    "music_dsl": "file:../../music-dsl/ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
