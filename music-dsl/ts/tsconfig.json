{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2021"], "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "noImplicitOverride": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "declaration": true, "noEmit": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "types": []
  },
  "include": ["src"]
}
