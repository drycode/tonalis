{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tonalis/conformance/music-dsl/case.schema.json",
  "title": "music-dsl conformance case",
  "description": "A single language-agnostic conformance case for the music_dsl theory library. Op-dispatched: the runner calls OPS[op](**args) and asserts `expect`. Mirrors conformance/dsl-core/schema. Function ops assert expect.value; model ops assert expect.model; error ops assert expect.error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "op", "args", "expect"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "description": "Unique, human-readable case id." },
    "op": { "type": "string", "minLength": 1, "description": "Op name; the cross-port contract. Each runner implements the same set." },
    "args": { "type": "object", "description": "Keyword args passed to the op." },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["value"],
          "properties": {
            "value": {},
            "model": false,
            "error": false
          }
        },
        {
          "required": ["model"],
          "properties": {
            "value": false,
            "model": {},
            "error": false
          }
        },
        {
          "required": ["error"],
          "properties": {
            "value": false,
            "model": false,
            "error": {}
          }
        }
      ],
      "description": "Exactly one of value (function ops), model (model ops), or error (failure sentinel).",
      "properties": {
        "value": { "type": ["boolean", "integer", "string", "array"], "items": { "type": "integer" } },
        "model": {
          "type": "object",
          "description": "Model op result. For parse_chord: { chord: <ChordModel> }. For parse_numeric/numeric_from_chord: { numeric: <NumericModel> }. For chord_in_key: { chord: <ChordModel> }.",
          "properties": {
            "chord": {
              "type": "object",
              "additionalProperties": false,
              "required": ["root", "triad", "seventh", "extensions", "harmonic_function", "substitution"],
              "properties": {
                "root": {
                  "type": "string",
                  "description": "Flat-normalised note name: C, Db, D, Eb, E, F, Gb, G, Ab, A, Bb, B."
                },
                "triad": {
                  "type": "string",
                  "enum": ["", "-", "h", "o", "+", "sus", "sus2", "sus4"],
                  "description": "Triad quality value: empty string = major."
                },
                "seventh": {
                  "type": "string",
                  "enum": ["^7", "7", ""],
                  "description": "Seventh value: ^7 = major, 7 = minor, empty = none."
                },
                "extensions": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Extension values in parse order."
                },
                "harmonic_function": {
                  "type": "string",
                  "enum": ["Tonic", "Dominant", "Subdominant"],
                  "description": "HarmonicFunctions enum NAME."
                },
                "substitution": {
                  "type": "boolean",
                  "description": "Whether this chord is a substitution. Always false for absolute Chord instances."
                }
              }
            },
            "numeric": {
              "description": "Numeric chord model. For parse_numeric: { numerator: <NumericChordModel>, denominator: <NumericChordModel>|null }. For numeric_from_chord: the ChordAttrs model directly (root is a ScaleDegree value).",
              "oneOf": [
                {
                  "type": "object",
                  "description": "parse_numeric result: numerator + denominator.",
                  "additionalProperties": false,
                  "required": ["numerator", "denominator"],
                  "properties": {
                    "numerator": { "$ref": "#/definitions/numericChordModel" },
                    "denominator": {
                      "oneOf": [
                        { "$ref": "#/definitions/numericChordModel" },
                        { "type": "null" }
                      ],
                      "description": "Denominator of a slash chord, or null."
                    }
                  }
                },
                { "$ref": "#/definitions/numericChordModel" }
              ]
            }
          }
        },
        "error": { "const": true }
      }
    }
  },
  "definitions": {
    "numericChordModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "triad", "seventh", "extensions", "harmonic_function", "substitution"],
      "description": "A chord-model whose root is a ScaleDegree value (Roman numeral string).",
      "properties": {
        "root": {
          "type": "string",
          "description": "ScaleDegree value: Roman numeral like 'I', 'ii', 'bVI', '#iv', 'V', etc."
        },
        "triad": {
          "type": "string",
          "enum": ["", "-", "h", "o", "+", "sus", "sus2", "sus4"],
          "description": "Triad quality value: empty string = major."
        },
        "seventh": {
          "type": "string",
          "enum": ["^7", "7", ""],
          "description": "Seventh value: ^7 = major, 7 = minor, empty = none."
        },
        "extensions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Extension values in parse order."
        },
        "harmonic_function": {
          "type": "string",
          "enum": ["Tonic", "Dominant", "Subdominant"],
          "description": "HarmonicFunctions enum NAME."
        },
        "substitution": {
          "type": "boolean",
          "description": "Whether this chord is a tritone substitution."
        }
      }
    }
  }
}
