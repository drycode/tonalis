{
  "name": "tonalis",
  "version": "0.1.0",
  "description": "Tonalis — a generic, format-agnostic music-harmony DSL (parse/lint/AST/JSON/text). Depends only on the pure @tonalis/music-dsl theory library; ships compiled ESM + type declarations, browser + Node safe.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/drycode/tonalis.git", "directory": "tonalis/ts" },
  "homepage": "https://github.com/drycode/tonalis#readme",
  "private": false,
  "dependencies": {
    "@tonalis/music-dsl": "file:../../music-dsl/ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
